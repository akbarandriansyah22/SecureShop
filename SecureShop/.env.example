# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
ENVIRONMENT=development

# Database
# local go run: localhost | docker compose: postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
# Generate: openssl rand -base64 24   (min 16 chars; do not use change-me)
DB_PASSWORD=
DB_NAME=ecommerce
DB_SSLMODE=disable

# JWT (min 32 chars; generate: openssl rand -hex 32). Do not commit a real value.
JWT_SECRET=
JWT_EXPIRATION_HOURS=2

# Must match ecommerce-api/monitoring/secrets/metrics_token
# Generate: openssl rand -hex 32
METRICS_TOKEN=

# CORS. "*" is a lab default: any site can call the API from a browser.
# Credentials are off while the value is "*". Production startup rejects "*".
# Set explicit origins (https://shop.example) before a public deployment.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Authorization

# Application
APP_NAME=E-Commerce API
APP_VERSION=1.0.0
LOG_LEVEL=info

GRAFANA_ADMIN_USER=admin
# Generate a password. Compose refuses to start if this is empty.
GRAFANA_ADMIN_PASSWORD=
